# ---------------------------------------------------------------------------
# NOTHING FROM THE GAME, THE DLC, THE FIRMWARE OR SONY GOES IN THIS REPOSITORY.
# Everything below is generated locally from the player's own disc and their
# own add-on content.
# ---------------------------------------------------------------------------

# Toolkit checkouts and the Python venv
/ps3recomp/
/ps3recomp-asura/
/.venv/

# The disc image (a link to the player's own ISO) and its contents
/game_iso
*.iso
*.ISO
PS3_GAME/
PS3_UPDATE/
*.BIN
*.bin
*.elf
*.ELF
*.self
*.SELF
*.sprx
*.SPRX
*.prx
*.PRX
*.SFO
*.sfo
*.XXX
*.xxx
*.TFC
*.tfc
*.bik
*.pam
*.PAM
*.at3
*.AT3

# The DLC: downloaded packages, unpacked trees (never commit any of it)
dlc/

# Decrypted game files, analysis and lifted output
game/
analysis/
recompiled/
build/
cache/
# Lifted SPU code and its workload table are derived from game code:
# regenerate them with tools/rebuild.sh spu, never commit them.
port/spu/

# Firmware and keys
fw/
dev_flash/
dev_flash*/
*.keys
*.KEYS
self_keys*.txt
*.rap
*.RAP
*.rif
*.act.dat
idps*
act.dat

# Saves, installed game data, run directories
rpcs3/
saves/
gamedata/
dev_hdd0/
dev_hdd1/
dev_bdvd/
vfs/
out/
runs/
*.sav
*.SAV

# Frame dumps, captures and logs
*.ppm
*.wav
*.log
*.sample
*.trace
*.orig

# Editor / OS noise
.DS_Store
.vscode/
.idea/
__pycache__/
*.pyc

# Local orchestration notes (not part of the port)
ASURAS_WRATH_MULTIAGENTE.md
