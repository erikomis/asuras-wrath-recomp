diff --git a/libs/misc/cellOvis.c b/libs/misc/cellOvis.c
index 7e6968a0..180f9479 100644
--- a/libs/misc/cellOvis.c
+++ b/libs/misc/cellOvis.c
@@ -1,65 +1,70 @@
-/*
- * ps3recomp - cellOvis HLE implementation
- *
- * Stub. Init/term work, overlay creation succeeds as no-op.
- */
-
 #include "cellOvis.h"
 #include <stdio.h>
-#include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
-
-/* Internal state */
-
-static int s_initialized = 0;
-static u32 s_next_handle = 1;
+#include "../../runtime/ppu/ppu_memory.h"
 
-/* API */
+#define SPU_ELF_MACHINE 23
+#define PT_LOAD_TYPE    1
 
-s32 cellOvisInit(void)
+static int spu_overlay_segments(u32 elf, u32* overlays)
 {
-    printf("[cellOvis] Init()\n");
-    if (s_initialized)
-        return (s32)CELL_OVIS_ERROR_ALREADY_INITIALIZED;
-    s_initialized = 1;
-    s_next_handle = 1;
-    return CELL_OK;
+    if (!elf || vm_read32(elf) != 0x7F454C46u)
+        return 0;
+    if ((vm_read32(elf + 4) >> 16) != 0x0102u || vm_read16(elf + 0x12) != SPU_ELF_MACHINE)
+        return 0;
+    const u32 phoff = vm_read32(elf + 0x1C);
+    const u32 phentsize = vm_read16(elf + 0x2A);
+    const u32 phnum = vm_read16(elf + 0x2C);
+    if (phentsize < 0x20 || phnum > 64)
+        return 0;
+    u32 n = 0;
+    for (u32 i = 0; i < phnum; i++) {
+        const u32 a = elf + phoff + i * phentsize;
+        if (vm_read32(a) != PT_LOAD_TYPE)
+            continue;
+        const u32 va = vm_read32(a + 8), sa = vm_read32(a + 0x14);
+        for (u32 j = 0; j < phnum; j++) {
+            const u32 b = elf + phoff + j * phentsize;
+            if (j == i || vm_read32(b) != PT_LOAD_TYPE)
+                continue;
+            const u32 vb = vm_read32(b + 8), sb = vm_read32(b + 0x14);
+            if (sa && sb && va < vb + sb && vb < va + sa) {
+                n++;
+                break;
+            }
+        }
+    }
+    *overlays = n;
+    return 1;
 }
 
-s32 cellOvisTerm(void)
+s32 cellOvisGetOverlayTableSize(u32 elf)
 {
-    printf("[cellOvis] Term()\n");
-    s_initialized = 0;
-    return CELL_OK;
-}
-
-s32 cellOvisGetOverlayTableSize(const char* filePath, u32* tableSize)
-{
-    (void)filePath;
-    if (!s_initialized) return (s32)CELL_OVIS_ERROR_NOT_INITIALIZED;
-    if (!tableSize) return (s32)CELL_OVIS_ERROR_INVALID_ARGUMENT;
-    vm_write32((u32)(uintptr_t)tableSize, (u32)0);
-    return CELL_OK;
-}
-
-s32 cellOvisCreateOverlay(const void* table, u32 tableSize, CellOvisHandle* handle)
-{
-    (void)table; (void)tableSize;
-    if (!s_initialized) return (s32)CELL_OVIS_ERROR_NOT_INITIALIZED;
-    if (!handle) return (s32)CELL_OVIS_ERROR_INVALID_ARGUMENT;
-    vm_write32((u32)(uintptr_t)handle, (u32)s_next_handle++);
-    return CELL_OK;
-}
-
-s32 cellOvisDestroyOverlay(CellOvisHandle handle)
-{
-    (void)handle;
-    if (!s_initialized) return (s32)CELL_OVIS_ERROR_NOT_INITIALIZED;
-    return CELL_OK;
+    u32 overlays = 0;
+    if (!spu_overlay_segments(elf, &overlays)) {
+        printf("[cellOvis] GetOverlayTableSize(elf=0x%08X) -> INVAL (not an SPU ELF)\n", elf);
+        return (s32)CELL_OVIS_ERROR_INVAL;
+    }
+    if (overlays) {
+        printf("[cellOvis] GetOverlayTableSize(elf=0x%08X): %u overlay segment(s); overlay tables are not implemented\n",
+               elf, overlays);
+        return (s32)CELL_OVIS_ERROR_INVAL;
+    }
+    printf("[cellOvis] GetOverlayTableSize(elf=0x%08X) -> 0 (no overlay segments)\n", elf);
+    return 0;
 }
 
-s32 cellOvisInvalidateOverlay(CellOvisHandle handle)
+s32 cellOvisInitializeOverlayTable(u32 ea_ovly_table, u32 elf)
 {
-    (void)handle;
-    if (!s_initialized) return (s32)CELL_OVIS_ERROR_NOT_INITIALIZED;
+    u32 overlays = 0;
+    if (!spu_overlay_segments(elf, &overlays)) {
+        printf("[cellOvis] InitializeOverlayTable(table=0x%08X, elf=0x%08X) -> INVAL (not an SPU ELF)\n",
+               ea_ovly_table, elf);
+        return (s32)CELL_OVIS_ERROR_INVAL;
+    }
+    if (overlays) {
+        printf("[cellOvis] InitializeOverlayTable(table=0x%08X, elf=0x%08X): %u overlay segment(s); overlay tables are not implemented\n",
+               ea_ovly_table, elf, overlays);
+        return (s32)CELL_OVIS_ERROR_INVAL;
+    }
     return CELL_OK;
 }
