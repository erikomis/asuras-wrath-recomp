 libs/misc/cellOvis.h               |  30 ++------
 libs/network/cellNetCtl.c          |  15 ++--
 runtime/memory/vm.h                |   6 +-
 runtime/ppu/ppu_loader.cpp         |   9 +--
 runtime/syscalls/sys_memory.c      |  72 ++++++++++++++++---
 9 files changed, 144 insertions(+), 109 deletions(-)

