 runtime/ppu/ppu_loader.cpp   | 628 +++--------------------------------
 runtime/spu/spu_channels.c   |  14 +-
 runtime/spu/spu_dma.h        | 121 ++-----
 runtime/spu/spu_vm_pagemap.c |  14 -
 5 files changed, 70 insertions(+), 709 deletions(-)
 delete mode 100644 runtime/spu/spu_vm_pagemap.c

