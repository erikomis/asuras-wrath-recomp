     CHECK_EQ_U32(g_spu_b.event_status, 0);
@@ -226,7 +225,7 @@ static void test_all_store_widths(void)
         case 3: vm_write64(LINE_C + 16, 0xA5A5A5A5A5A5A5A5ull);    break;
         }
