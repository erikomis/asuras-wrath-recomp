+        const int32_t old = ls[a], v = old + n;
+        ls[a] = (uint8_t)(v < 0 ? 0 : v > 255 ? 255 : v);
+        ll_commit(c, spurs, 0x100);
+        n += old;
+        if (n >= 0) return rc;
+    }
+}
