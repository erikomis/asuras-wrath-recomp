+        vm(SPURS)[0x00 + i] = 1;
+        vm(SPURS)[0x50 + i] = 1;
+        ls(0x1A0)[i] = 3;
+    }
+    p16(ls(0x1EC), 0x6000);
+    kernel_select(C, 0, r);
+    CHECK(r[0] == 1, "tie picks %X", r[0]);
+    fresh(0, 0x20);
+    for (int i = 1; i <= 2; i++) {
+        vm(SPURS)[0x00 + i] = 1;
+        vm(SPURS)[0x50 + i] = 1;
+        ls(0x1A0)[i] = 3;
+    }
+    p16(ls(0x1EC), 0x6000);
