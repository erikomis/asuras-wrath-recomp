+    CHECK(g32(ls(0x1DC)) == 0 && ls(0x1EB)[0] == 0, "cur %X idle %u", g32(ls(0x1DC)), ls(0x1EB)[0]);
+    CHECK(!memcmp(ls(0x100), vm(SPURS), 128), "LS line-0 mirror differs from the committed line");
