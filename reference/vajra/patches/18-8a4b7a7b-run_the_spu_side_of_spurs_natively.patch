+    ts_st(ls + 0x2710, RDY);
+    ts_st(ls + 0x2730, EN);
+    ts_st(ls + 0x2740, SIG);
+    ts_st(ls + 0x2750, WAIT);
+    ll_commit(c, ea, 0x2700);
+    const uint32_t spurs = spurs_ea(c) & ~127u;
