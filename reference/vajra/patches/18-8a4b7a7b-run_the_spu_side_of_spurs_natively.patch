+static void ss_entry(spu_context* c, uint64_t arg, uint32_t ps)
+{
+    uint8_t* ls = c->ls;
+    memset(ls + 0x3FFF0, 0, 16);
+    psplat(ls + 0x3FFD0, 0x3FFF0);
+    memset(ls + 0x3FFE0, 0, 16);
+    if (g32(ls + 0x1DC) == 32) ss_main(c);
